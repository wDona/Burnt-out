-- ====== TAREAS ======

insertTarea:
INSERT INTO TareaEntity(ID_Tarea, Titulo, Descripcion, Estado, FK_ID_Tabl, FK_ID_Usuario, Fecha_Vencimiento, Notificacion_Personalizada, Updated_At)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertTarea:
INSERT OR REPLACE INTO TareaEntity(ID_Tarea, Titulo, Descripcion, Estado, FK_ID_Tabl, FK_ID_Usuario, Fecha_Vencimiento, Notificacion_Personalizada, Is_Deleted, Updated_At)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getTareaById:
SELECT * FROM TareaEntity WHERE ID_Tarea = ? AND Is_Deleted = 0;

getTareasByTablero:
SELECT * FROM TareaEntity WHERE FK_ID_Tabl = ? AND Is_Deleted = 0;

updateTareaById:
UPDATE TareaEntity SET Titulo = ?, Descripcion = ?, Estado = ?, Fecha_Vencimiento = ?, Notificacion_Personalizada = ?, Updated_At = ? WHERE ID_Tarea = ?;

assignTareaToUsuario:
UPDATE TareaEntity SET FK_ID_Usuario = ?, Updated_At = ? WHERE ID_Tarea = ?;

deleteTareaById:
UPDATE TareaEntity SET Is_Deleted = 1, Updated_At = ? WHERE ID_Tarea = ?;

deleteTareasByTablero:
UPDATE TareaEntity SET Is_Deleted = 1, Updated_At = ? WHERE FK_ID_Tabl = ?;

-- ===== Operaciones Pendientes =====
insertOperacionPendiente:
INSERT INTO OperacionPendienteEntity(tipo_accion, tabla_afectada, id_afectado, datos_json, timestamp_creacion, sincronizado)
VALUES(?, ?, ?, ?, ?, ?);

getOperacionesPendientes:
SELECT * FROM OperacionPendienteEntity WHERE sincronizado = 0 ORDER BY timestamp_creacion
LIMIT ?;

deleteOperacionesPendientesById:
DELETE FROM OperacionPendienteEntity WHERE ID_Operacion = ?;

cambiarEstadoOperacionPendiente:
UPDATE OperacionPendienteEntity SET sincronizado = ? WHERE ID_Operacion = ?;

deleteOperacionesPorEstado:
DELETE FROM OperacionPendienteEntity WHERE sincronizado = ?;

