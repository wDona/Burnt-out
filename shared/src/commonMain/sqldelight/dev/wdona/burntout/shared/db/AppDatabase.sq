-- ====== RESPUESTAS ======
insertRespuesta:
INSERT OR REPLACE INTO ResponderEntity(ID_Respuesta, ID_Usuario, ID_Pregunta, Anonimo, Respuesta, Fecha, Updated_At)
VALUES(?, ?, ?, ?, ?, ?, ?);

deleteRespuestaByDate:
UPDATE ResponderEntity SET Is_Deleted = 1, Updated_At = ?
WHERE ID_Usuario = ?
AND ID_Pregunta = ?
AND date(Fecha, 'unixepoch', 'localtime') = date(?, 'unixepoch', 'localtime');

getRespuestasByPregunta:
SELECT r.ID_Usuario, r.ID_Pregunta, r.Respuesta, r.Anonimo, u.Nombre
FROM ResponderEntity r JOIN UsuarioEntity u ON r.ID_Usuario = u.ID_Usuario
WHERE r.ID_Pregunta = ? AND r.Is_Deleted = 0;

getRespuestasByUser:
SELECT * FROM ResponderEntity WHERE ID_Usuario = ? AND Is_Deleted = 0;

getLastRespuestasByUser:
SELECT r1.*
FROM ResponderEntity r1
JOIN (
    SELECT ID_Pregunta, MAX(Fecha) MaxFecha
    FROM ResponderEntity
    WHERE ID_Usuario = ? AND Is_Deleted = 0
    GROUP BY ID_Pregunta
) r2 ON r1.ID_Pregunta = r2.ID_Pregunta AND r1.Fecha = r2.MaxFecha
WHERE r1.ID_Usuario = ? AND r1.Is_Deleted = 0
ORDER BY r1.Fecha DESC;

getRespuestasByUserAndDate:
SELECT * FROM ResponderEntity
WHERE ID_Usuario = ?
AND date(Fecha, 'unixepoch', 'localtime') = date(?, 'unixepoch', 'localtime');

insertRespuestasBase:
INSERT OR IGNORE INTO ResponderEntity(ID_Respuesta, ID_Usuario, ID_Pregunta, Anonimo, Respuesta, Fecha, Updated_At)
SELECT :idRespuesta, :idUsuario, ID_Pregunta, 0, -6, :fecha, 0
FROM PreguntaEntity
WHERE FK_ID_Org = -9223372036854775808;

