-- ====== TAREAS ======

-- Usar esta para crear tareas locales (ID autogenerado)
insertTarea:
INSERT INTO TareaEntity(Titulo, Descripcion, Estado, FK_ID_Tabl, FK_ID_Usuario)
VALUES(?, ?, ?, ?, ?);

-- Usar esta para sincronizar (ID específico)
upsertTarea:
INSERT OR REPLACE INTO TareaEntity(ID_Tarea, Titulo, Descripcion, Estado, FK_ID_Tabl, FK_ID_Usuario, Is_Deleted)
VALUES(?, ?, ?, ?, ?, ?, ?);

getTareaById:
SELECT * FROM TareaEntity WHERE ID_Tarea = ? AND Is_Deleted = 0;

getTareasByTablero:
SELECT * FROM TareaEntity WHERE FK_ID_Tabl = ? AND Is_Deleted = 0;

updateTareaById:
UPDATE TareaEntity SET Titulo = ?, Descripcion = ?, Estado = ? WHERE ID_Tarea = ?;

assignTareaToUsuario:
UPDATE TareaEntity SET FK_ID_Usuario = ? WHERE ID_Tarea = ?;

deleteTareaById:
UPDATE TareaEntity SET Is_Deleted = 1 WHERE ID_Tarea = ?;

deleteTareasByTablero:
UPDATE TareaEntity SET Is_Deleted = 1 WHERE FK_ID_Tabl = ?;

-- ===== Operaciones Pendientes =====
insertOperacionPendiente:
INSERT INTO OperacionPendienteEntity(tipo_accion, tabla_afectada, id_afectado, datos_json, timestamp_creacion, sincronizado)
VALUES(?, ?, ?, ?, ?, ?);

getOperacionesPendientes:
SELECT * FROM OperacionPendienteEntity WHERE sincronizado = 0 ORDER BY timestamp_creacion
LIMIT ?;

deleteOperacionesPendientesById:
DELETE FROM OperacionPendienteEntity WHERE ID_Operacion = ?;

cambiarEstadoOperacionPendiente:
UPDATE OperacionPendienteEntity SET sincronizado = ? WHERE ID_Operacion = ?;

deleteOperacionesPorEstado:
DELETE FROM OperacionPendienteEntity WHERE sincronizado = ?;

-- ==== Tableros ====
insertTablero:
INSERT INTO TableroEntity(Titulo, FK_ID_Equipo, FK_ID_Org)
VALUES(?, ?, ?);

upsertTablero:
INSERT OR REPLACE INTO TableroEntity(ID_Tabl, Titulo, FK_ID_Equipo, FK_ID_Org, Is_Deleted)
VALUES(?, ?, ?, ?, ?);

getTableroById:
SELECT * FROM TableroEntity WHERE ID_Tabl = ? AND Is_Deleted = 0;

getTablerosByOrg:
SELECT * FROM TableroEntity WHERE FK_ID_Org = ? AND Is_Deleted = 0;

updateTablero:
UPDATE TableroEntity SET Titulo = ?, FK_ID_Equipo = ? WHERE ID_Tabl = ?;

deleteTablero:
UPDATE TableroEntity SET Is_Deleted = 1 WHERE ID_Tabl = ?;

deleteTablerosByOrg:
UPDATE TableroEntity SET Is_Deleted = 1 WHERE FK_ID_Org = ?;

-- ===== Equipos =====
insertEquipo:
INSERT INTO EquipoEntity(Titulo, FK_ID_Org)
VALUES(?, ?);

upsertEquipo:
INSERT OR REPLACE INTO EquipoEntity(ID_Equipo, Titulo, Puntuacion, FK_ID_Org, Is_Deleted)
VALUES(?, ?, ?, ?, ?);

getEquipoById:
SELECT * FROM EquipoEntity WHERE ID_Equipo = ? AND Is_Deleted = 0;

getEquiposByOrg:
SELECT * FROM EquipoEntity WHERE FK_ID_Org = ? AND Is_Deleted = 0;

updateEquipo:
UPDATE EquipoEntity SET Titulo = ? WHERE ID_Equipo = ?;

deleteEquipo:
UPDATE EquipoEntity SET Is_Deleted = 1 WHERE ID_Equipo = ?;

deleteEquiposByOrg:
UPDATE EquipoEntity SET Is_Deleted = 1 WHERE FK_ID_Org = ?;

updatePuntuacionEquipo:
UPDATE EquipoEntity SET Puntuacion = Puntuacion + ? WHERE ID_Equipo = ?;

getLeaderboard:
SELECT * FROM EquipoEntity WHERE Is_Deleted = 0 ORDER BY Puntuacion DESC;

-- ==== Usuarios ====
insertUsuario:
INSERT INTO UsuarioEntity(Username, Contrasena, Nombre, Riesgo_Burnout, Descripcion, FK_ID_Organizacion, FK_ID_Equipo)
VALUES(?, ?, ?, ?, ?, ?, ?);

upsertUsuario:
INSERT OR REPLACE INTO UsuarioEntity(ID_Usuario, Username, Contrasena, Nombre, Riesgo_Burnout, Descripcion, FK_ID_Organizacion, FK_ID_Equipo, Is_Deleted)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?);

getUserById:
SELECT * FROM UsuarioEntity WHERE ID_Usuario = ? AND Is_Deleted = 0;

getUsuariosByOrg:
SELECT * FROM UsuarioEntity WHERE FK_ID_Organizacion = ? AND Is_Deleted = 0;

getUsuarioByUsername:
SELECT * FROM UsuarioEntity WHERE Username = ? AND Is_Deleted = 0;

getUsuariosByEquipo:
SELECT u.*
FROM UsuarioEntity u JOIN User_TeamEntity ut ON u.ID_Usuario = ut.ID_Usuario
WHERE ut.ID_Equipo = ? AND u.Is_Deleted = 0;

updateUsuario:
UPDATE UsuarioEntity SET Username = ?, Contrasena = ?, Nombre = ?, Riesgo_Burnout = ?, Descripcion = ?, FK_ID_Equipo = ? WHERE ID_Usuario = ?;

updateUsuarioTeamId:
UPDATE UsuarioEntity SET FK_ID_Equipo = ? WHERE ID_Usuario = ?;

deleteUsuario:
UPDATE UsuarioEntity SET Is_Deleted = 1 WHERE ID_Usuario = ?;

deleteUsuariosByOrg:
UPDATE UsuarioEntity SET Is_Deleted = 1 WHERE FK_ID_Organizacion = ?;

updateRiesgoBurnout:
UPDATE UsuarioEntity SET Riesgo_Burnout = ? WHERE ID_Usuario = ?;

getUsuariosConRiesgoAlto:
SELECT * FROM UsuarioEntity WHERE Riesgo_Burnout > ? AND Is_Deleted = 0;

-- ====== SUBTAREAS ======
insertSubtarea:
INSERT INTO SubtareaEntity(Titulo, Completado, FK_ID_Tarea) VALUES(?, ?, ?);

upsertSubtarea:
INSERT OR REPLACE INTO SubtareaEntity(ID_Subtarea, Titulo, Completado, FK_ID_Tarea, Is_Deleted) VALUES(?, ?, ?, ?, ?);

getSubtareasByTarea:
SELECT * FROM SubtareaEntity WHERE FK_ID_Tarea = ? AND Is_Deleted = 0;

updateSubtarea:
UPDATE SubtareaEntity SET Titulo = ?, Completado = ? WHERE ID_Subtarea = ?;

deleteSubtarea:
UPDATE SubtareaEntity SET Is_Deleted = 1 WHERE ID_Subtarea = ?;

-- ====== PREGUNTAS / ENCUESTAS ======
insertPregunta:
INSERT INTO PreguntaEntity(Pregunta, Categoria, FK_ID_Org) VALUES(?, ?, ?);

upsertPregunta:
INSERT OR REPLACE INTO PreguntaEntity(ID_Pregunta, Pregunta, Categoria, FK_ID_Org, Is_Deleted) VALUES(?, ?, ?, ?, ?);

getPreguntasByOrg:
SELECT * FROM PreguntaEntity WHERE FK_ID_Org = ? AND Is_Deleted = 0;

updatePregunta:
UPDATE PreguntaEntity SET Pregunta = ?, Categoria = ? WHERE ID_Pregunta = ?;

deletePregunta:
UPDATE PreguntaEntity SET Is_Deleted = 1 WHERE ID_Pregunta = ?;

-- ====== RESPUESTAS ======
insertRespuesta:
INSERT OR REPLACE INTO ResponderEntity(ID_Usuario, ID_Pregunta, Anonimo, Respuesta, Fecha)
VALUES(?, ?, ?, ?, ?);

deleteRespuestaByDate:
DELETE FROM ResponderEntity
WHERE ID_Usuario = ?
AND ID_Pregunta = ?
AND date(Fecha, 'unixepoch', 'localtime') = date(?, 'unixepoch', 'localtime');

getRespuestasByPregunta:
SELECT r.ID_Usuario, r.ID_Pregunta, r.Respuesta, r.Anonimo, u.Nombre
FROM ResponderEntity r JOIN UsuarioEntity u ON r.ID_Usuario = u.ID_Usuario
WHERE r.ID_Pregunta = ?;

getRespuestasByUser:
SELECT * FROM ResponderEntity WHERE ID_Usuario = ?;

getLastRespuestasByUser:
SELECT r1.*
FROM ResponderEntity r1
JOIN (
    SELECT ID_Pregunta, MAX(Fecha) MaxFecha
    FROM ResponderEntity
    WHERE ID_Usuario = ?
    GROUP BY ID_Pregunta
) r2 ON r1.ID_Pregunta = r2.ID_Pregunta AND r1.Fecha = r2.MaxFecha
WHERE r1.ID_Usuario = ?
ORDER BY r1.Fecha DESC;

getRespuestasByUserAndDate:
SELECT * FROM ResponderEntity
WHERE ID_Usuario = ?
AND date(Fecha, 'unixepoch', 'localtime') = date(?, 'unixepoch', 'localtime');

insertRespuestasBase:
INSERT OR IGNORE INTO ResponderEntity(ID_Usuario, ID_Pregunta, Anonimo, Respuesta, Fecha)
SELECT :idUsuario, ID_Pregunta, 0, -6, :fecha
FROM PreguntaEntity
WHERE FK_ID_Org = -9223372036854775808;

-- ====== AJUSTES USUARIO ======
insertOrUpdateAjusteUser:
INSERT OR REPLACE INTO Ajuste_UserEntity(ID_Usuario, ID_Ajuste, Valor_Ajuste)
VALUES(?, ?, ?);

getAjustesByUser:
SELECT a.Nombre_Ajuste, au.Valor_Ajuste
FROM AjusteEntity a JOIN Ajuste_UserEntity au ON a.ID_Ajuste = au.ID_Ajuste
WHERE au.ID_Usuario = ?;

-- ====== EQUIPOS - USUARIOS ======
insertUserTeam:
INSERT OR IGNORE INTO User_TeamEntity(ID_Usuario, ID_Equipo) VALUES(?, ?);

deleteUserTeam:
DELETE FROM User_TeamEntity WHERE ID_Usuario = ? AND ID_Equipo = ?;

deleteUserFromAllTeams:
DELETE FROM User_TeamEntity WHERE ID_Usuario = ?;

deleteEmptyTeams:
UPDATE EquipoEntity SET Is_Deleted = 1
WHERE ID_Equipo NOT IN (SELECT DISTINCT ID_Equipo FROM User_TeamEntity)
AND Is_Deleted = 0;

-- ====== ORGANIZACIONES ======
getAllOrganizaciones:
SELECT * FROM OrganizacionEntity WHERE Is_Deleted = 0;

upsertOrganizacion:
INSERT OR REPLACE INTO OrganizacionEntity(ID_Org, Org_Name, Is_Deleted) VALUES(?, ?, ?);

updateOrganizacion:
UPDATE OrganizacionEntity SET Org_Name = ? WHERE ID_Org = ?;

deleteOrganizacion:
UPDATE OrganizacionEntity SET Is_Deleted = 1 WHERE ID_Org = ?;

-- ===== OTROS =====
getOrganizacionById:
SELECT * FROM OrganizacionEntity WHERE ID_Org = ? AND Is_Deleted = 0;

getAjustesByUsuario:
SELECT a.ID_Ajuste, a.Nombre_Ajuste, au.Valor_Ajuste
FROM AjusteEntity a JOIN Ajuste_UserEntity au ON a.ID_Ajuste = au.ID_Ajuste
WHERE au.ID_Usuario = ? AND a.Is_Deleted = 0;

getAjusteByIdYUsuario:
SELECT a.ID_Ajuste, a.Nombre_Ajuste, au.Valor_Ajuste
FROM AjusteEntity a JOIN Ajuste_UserEntity au ON a.ID_Ajuste = au.ID_Ajuste
WHERE au.ID_Usuario = ? AND a.ID_Ajuste = ? AND a.Is_Deleted = 0;

clearDB:
DELETE FROM SubtareaEntity;
DELETE FROM TareaEntity;
DELETE FROM TableroEntity;
DELETE FROM EquipoEntity;
DELETE FROM UsuarioEntity;
DELETE FROM OrganizacionEntity;
DELETE FROM PreguntaEntity;
DELETE FROM ResponderEntity;
DELETE FROM AjusteEntity;
DELETE FROM Ajuste_UserEntity;
DELETE FROM User_TeamEntity;
DELETE FROM OperacionPendienteEntity;