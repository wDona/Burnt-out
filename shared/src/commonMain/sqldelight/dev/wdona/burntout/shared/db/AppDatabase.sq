-- ====== EQUIPOS - USUARIOS ======
insertUserTeam:
INSERT OR IGNORE INTO User_TeamEntity(ID_Usuario, ID_Equipo, Updated_At) VALUES(?, ?, ?);

deleteUserTeam:
UPDATE User_TeamEntity SET Is_Deleted = 1, Updated_At = ? WHERE ID_Usuario = ? AND ID_Equipo = ?;

deleteUserFromAllTeams:
UPDATE User_TeamEntity SET Is_Deleted = 1, Updated_At = ? WHERE ID_Usuario = ?;

deleteEmptyTeams:
UPDATE EquipoEntity SET Is_Deleted = 1, Updated_At = ?
WHERE ID_Equipo NOT IN (SELECT DISTINCT ID_Equipo FROM User_TeamEntity WHERE Is_Deleted = 0)
AND Is_Deleted = 0;

