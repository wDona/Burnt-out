updateOrganizacion:
UPDATE OrganizacionEntity SET Org_Name = ?, Updated_At = ? WHERE ID_Org = ?;

deleteOrganizacion:
UPDATE OrganizacionEntity SET Is_Deleted = 1, Updated_At = ? WHERE ID_Org = ?;

