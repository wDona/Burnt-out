deleteUsuariosByOrg:
UPDATE UsuarioEntity SET Is_Deleted = 1, Updated_At = ? WHERE FK_ID_Organizacion = ?;

updateRiesgoBurnout:
UPDATE UsuarioEntity SET Riesgo_Burnout = ?, Updated_At = ? WHERE ID_Usuario = ?;

getUsuariosConRiesgoAlto:
SELECT * FROM UsuarioEntity WHERE Riesgo_Burnout > ? AND Is_Deleted = 0;

